# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/config_table_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT  (must match the SECRET_KEY used by Service_Login)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Config Service (for Key/Value ID validation)
CONFIG_SERVICE_URL=http://config-service:8000

# App
APP_NAME=Config Table Service
DEBUG=False
LOG_LEVEL=INFO

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900
SESSION_EXPIRE_SECONDS=86400

# Host port (avoid conflicts with existing services)
APP_HOST_PORT=18001
